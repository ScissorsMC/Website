---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
    title?: string;
    description?: string;
}

const {
    title = 'Scissors - Minecraft server software',
    description = 'Scissors is a Paper fork that patches the Creative Mode exploits Paper refuses to.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <title>{title}</title>
        <link rel="canonical" href={canonical} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Scissors" />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
        <Font cssVariable="--font-space-grotesk" preload />
        <Font cssVariable="--font-jetbrains-mono" />
        <ClientRouter />
    </head>
    <body class="flex min-h-screen flex-col">
        <header class="border-b border-edge">
            <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
                <a href="/" class="flex items-center gap-2 font-display text-lg font-bold tracking-tight">
                    <svg aria-hidden="true" class="size-5" viewBox="0 0 128 128" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <clipPath id="logo-cut-a"><polygon points="0,0 128,0 128,26.8 0,99.2"></polygon></clipPath>
                            <clipPath id="logo-cut-b"><polygon points="0,99.2 128,26.8 128,128 0,128"></polygon></clipPath>
                        </defs>
                        <path
                            d="M 83 33 A 21 21 0 1 0 64 63 A 21 21 0 1 1 45 93"
                            fill="none"
                            class="stroke-steel"
                            stroke-width="13"
                            stroke-linecap="round"
                            clip-path="url(#logo-cut-a)"></path>
                        <g transform="translate(2.5 4)">
                            <path
                                d="M 83 33 A 21 21 0 1 0 64 63 A 21 21 0 1 1 45 93"
                                fill="none"
                                class="stroke-steel"
                                stroke-width="13"
                                stroke-linecap="round"
                                clip-path="url(#logo-cut-b)"></path>
                        </g>
                        <path
                            d="M 10 93.5 L 40 76.6 M 88 49.4 L 118 32.5"
                            fill="none"
                            class="stroke-fog"
                            stroke-width="3"
                            stroke-dasharray="7 6"></path>
                    </svg>
                    Scissors
                </a>
                <div class="flex items-center gap-6 text-sm text-fog">
                    <a href="/downloads" class="transition-colors hover:text-paper">Downloads</a>
                    <a
                        href="https://github.com/ScissorsMC/Scissors"
                        class="transition-colors hover:text-paper">GitHub</a
                    >
                </div>
            </nav>
        </header>

        <main class="mx-auto w-full max-w-5xl flex-1 px-6">
            <slot />
        </main>

        <footer class="mt-20 border-t border-edge">
            <div class="mx-auto max-w-5xl px-6 py-8 text-sm text-fog">
                <p>© {new Date().getFullYear()} Scissors</p>
            </div>
        </footer>
    </body>
</html>
