---
import Layout from '../../layouts/Layout.astro';
import CutLine from '../../components/CutLine.astro';
import EditionChooser from '../../components/EditionChooser.astro';
import ServerPanels from '../../components/ServerPanels.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getFillVersions, LEGACY_VERSIONS, type FillVersion } from '../../lib/builds';

let fillVersions: FillVersion[] = [];
let fillError = false;
try {
    fillVersions = await getFillVersions();
    fillError = fillVersions.length === 0;
} catch {
    fillError = true;
}

const supported = fillVersions.filter((v) => v.status === 'SUPPORTED');
const retired = fillVersions.filter((v) => v.status !== 'SUPPORTED');
---

<Layout title="Downloads - Scissors">
    <section class="pt-16 pb-12">
        <h1 class="font-display text-4xl font-bold tracking-tight">Downloads</h1>
        <p class="mt-3 max-w-2xl text-fog">
            Choose the scheduler that fits your server, then grab a build.
        </p>
        <div class="mt-8"><EditionChooser active="paper" /></div>
    </section>

    <section aria-labelledby="current-heading">
        <h2 id="current-heading" class="font-display text-xl font-medium">Current Paper builds</h2>
        {
            fillError ? (
                <p class="mt-4 rounded-md border border-edge bg-surface p-4 text-sm text-fog">
                    Couldn't load versions right now. Give it a minute and refresh.
                </p>
            ) : supported.length === 0 ? (
                <p class="mt-4 rounded-md border border-edge bg-surface p-4 text-sm text-fog">
                    No version is under active support right now. Grab the newest build from the
                    list below.
                </p>
            ) : (
                <div class="mt-4 grid gap-4 sm:grid-cols-2">
                    {supported.map((v) => (
                        <a
                            href={`/downloads/${v.id}`}
                            class="group flex items-center justify-between rounded-lg border border-edge bg-surface p-5 transition-colors hover:border-fog"
                        >
                            <div>
                                <span class="font-display text-2xl font-bold">{v.id}</span>
                                {v.javaMinimum && (
                                    <p class="mt-1 font-mono text-xs text-fog">Java {v.javaMinimum}+</p>
                                )}
                            </div>
                            <div class="flex items-center gap-3">
                                <StatusBadge status={v.status} />
                                <svg
                                    class="h-5 w-5 text-fog transition-colors group-hover:text-paper"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <path d="m9 18 6-6-6-6" />
                                </svg>
                            </div>
                        </a>
                    ))}
                </div>
            )
        }
    </section>

    <div class="py-12"><CutLine /></div>

    <ServerPanels project="scissors" />

    <div class="py-12"><CutLine /></div>

    <section aria-labelledby="legacy-heading">
        <h2 id="legacy-heading" class="font-display text-xl font-medium">Older versions</h2>
        <p class="mt-2 max-w-2xl text-sm text-fog">
            These versions no longer get updates, but their builds are still available if you need
            them.
        </p>
        <ul class="mt-4 divide-y divide-edge rounded-lg border border-edge bg-surface">
            {
                retired.map((v) => (
                    <li class="flex items-center justify-between gap-4 p-4">
                        <div class="flex items-center gap-4">
                            <span class="font-display w-16 font-bold">{v.id}</span>
                            <StatusBadge status={v.status} />
                        </div>
                        <a
                            href={`/downloads/${v.id}`}
                            class="inline-flex items-center gap-1.5 text-sm text-steel transition-colors hover:text-steel-bright"
                        >
                            View builds
                            <svg
                                class="h-4 w-4"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="m9 18 6-6-6-6" />
                            </svg>
                        </a>
                    </li>
                ))
            }
            {
                LEGACY_VERSIONS.map((v) => (
                    <li class="flex items-center justify-between gap-4 p-4">
                        <div class="flex items-center gap-4">
                            <span class="font-display w-16 font-bold">{v}</span>
                            <StatusBadge status="UNSUPPORTED" />
                        </div>
                        <div class="flex items-center gap-5 text-sm">
                            <a
                                href={`/downloads/legacy/${v}`}
                                data-astro-prefetch="false"
                                class="hidden items-center gap-1.5 text-fog transition-colors hover:text-paper sm:inline-flex"
                            >
                                Latest build
                                <svg
                                    class="h-4 w-4"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <path d="M12 4v11" />
                                    <path d="m7 11 5 5 5-5" />
                                    <path d="M5 20h14" />
                                </svg>
                            </a>
                            <a
                                href={`/downloads/${v}`}
                                class="inline-flex items-center gap-1.5 text-steel transition-colors hover:text-steel-bright"
                            >
                                View builds
                                <svg
                                    class="h-4 w-4"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <path d="m9 18 6-6-6-6" />
                                </svg>
                            </a>
                        </div>
                    </li>
                ))
            }
        </ul>
    </section>

</Layout>
