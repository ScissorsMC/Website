---
import Layout from '../../../layouts/Layout.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import {
    formatDate,
    formatSize,
    getFillBuilds,
    getFillVersion,
    type FillBuild,
    type FillVersion,
} from '../../../lib/builds';

const versionId = Astro.params.version!;
let version: FillVersion | null = null;
let builds: FillBuild[] | null = null;

try {
    [version, builds] = await Promise.all([
        getFillVersion(versionId, 'scissors-folia'),
        getFillBuilds(versionId, 'scissors-folia'),
    ]);
} catch {
    // Rendered as the error state below.
}

if (!version) {
    return Astro.redirect('/downloads/folia');
}

const GITHUB_COMMIT = 'https://github.com/ScissorsMC/Scissors-Folia/commit';
---

<Layout title={`Scissors Folia ${versionId} - Downloads`}>
    <section class="pt-16 pb-10">
        <a
            href="/downloads/folia"
            class="inline-flex items-center gap-1 font-mono text-sm text-fog transition-colors hover:text-paper"
        >
            <span aria-hidden="true">←</span>
            All Folia versions
        </a>
        <div class="mt-4 flex flex-wrap items-center gap-4">
            <h1 class="font-display text-4xl font-bold tracking-tight">Scissors Folia {versionId}</h1>
            <StatusBadge status={version.status} />
        </div>
        {
            version.javaMinimum && (
                <p class="mt-3 font-mono text-sm text-fog">Requires Java {version.javaMinimum} or newer</p>
            )
        }
    </section>

    {
        !builds || builds.length === 0 ? (
            <p class="rounded-md border border-edge bg-surface p-4 text-sm text-fog">
                Couldn't load builds right now. Try again in a few minutes.
            </p>
        ) : (
            <ul class="space-y-4">
                {builds.map((build) => (
                    <li class="rounded-lg border border-edge bg-surface p-5">
                        <div class="flex flex-wrap items-center justify-between gap-4">
                            <div class="flex items-center gap-4">
                                <span class="font-mono text-lg font-medium">#{build.id}</span>
                                <span class="rounded-full border border-edge px-2.5 py-0.5 font-mono text-xs text-fog">
                                    {build.channel}
                                </span>
                                <span class="text-sm text-fog">{formatDate(build.time)}</span>
                            </div>
                            {build.download && (
                                <a
                                    href={build.download.url}
                                    data-astro-prefetch="false"
                                    class="font-display rounded-md bg-steel px-4 py-2 text-sm font-medium text-ink transition-colors hover:bg-steel-bright"
                                >
                                    {build.download.name}
                                    <span class="ml-1 font-normal opacity-70">{formatSize(build.download.size)}</span>
                                </a>
                            )}
                        </div>
                        {build.commits.length > 0 && (
                            <ul class="mt-4 space-y-1 border-t border-edge pt-3">
                                {build.commits.map((commit) => (
                                    <li class="flex items-baseline gap-3 text-sm">
                                        <a
                                            href={`${GITHUB_COMMIT}/${commit.sha}`}
                                            class="font-mono text-xs text-steel transition-colors hover:text-steel-bright"
                                        >
                                            {commit.sha.slice(0, 7)}
                                        </a>
                                        <span class="text-fog">{commit.message.split('\n')[0]}</span>
                                    </li>
                                ))}
                            </ul>
                        )}
                        {build.download?.sha256 && (
                            <p class="mt-3 truncate font-mono text-xs text-fog/70" title={build.download.sha256}>
                                sha256: {build.download.sha256}
                            </p>
                        )}
                    </li>
                ))}
            </ul>
        )
    }
</Layout>
