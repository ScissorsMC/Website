---
import Layout from '../../layouts/Layout.astro';
import FillBuildList from '../../components/FillBuildList.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import {
    formatDate,
    getFillBuilds,
    getFillVersion,
    getJenkinsBuilds,
    JENKINS_JOB,
    LEGACY_VERSIONS,
    type FillBuild,
    type FillVersion,
    type JenkinsBuild,
} from '../../lib/builds';

const versionId = Astro.params.version!;
const isLegacy = LEGACY_VERSIONS.includes(versionId);

let version: FillVersion | null = null;
let builds: FillBuild[] | null = null;
let jenkinsBuilds: JenkinsBuild[] | null = null;
try {
    if (isLegacy) {
        jenkinsBuilds = await getJenkinsBuilds(versionId);
    } else {
        [version, builds] = await Promise.all([getFillVersion(versionId), getFillBuilds(versionId)]);
    }
} catch {
    // Rendered as the error state below.
}

if (!isLegacy && !version) {
    return Astro.redirect('/downloads');
}

const status = isLegacy ? 'UNSUPPORTED' : version!.status;

const GITHUB_COMMIT = 'https://github.com/ScissorsMC/Scissors/commit';
---

<Layout title={`${versionId} Downloads - Scissors`}>
    <section class="pt-16 pb-10">
        <a
            href="/downloads"
            class="inline-flex items-center gap-1 font-mono text-sm text-fog transition-colors hover:text-paper"
        >
            <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <path d="m15 18-6-6 6-6" />
            </svg>
            All versions
        </a>
        <div class="mt-4 flex flex-wrap items-center gap-4">
            <h1 class="font-display text-4xl font-bold tracking-tight">Scissors {versionId}</h1>
            <StatusBadge status={status} />
        </div>
        {
            version?.javaMinimum && (
                <p class="mt-3 font-mono text-sm text-fog">Requires Java {version.javaMinimum} or newer</p>
            )
        }
        {
            isLegacy && (
                <p class="mt-3 max-w-2xl text-sm text-fog">
                    Only the builds still on <a
                        href={`${JENKINS_JOB}/${versionId}/`}
                        class="text-steel transition-colors hover:text-steel-bright">Jenkins</a
                    > are listed here. Older ones were rotated out.
                </p>
            )
        }
    </section>

    {
        isLegacy ? (
            !jenkinsBuilds || jenkinsBuilds.length === 0 ? (
                <p class="rounded-md border border-edge bg-surface p-4 text-sm text-fog">
                    Couldn't load builds right now. Try again in a few minutes.
                </p>
            ) : (
                <ul class="space-y-4">
                    {jenkinsBuilds.map((build) => (
                        <li class="flex flex-wrap items-center justify-between gap-4 rounded-lg border border-edge bg-surface p-5">
                            <div class="flex items-center gap-4">
                                <span class="font-mono text-lg font-medium">#{build.id}</span>
                                <span class="text-sm text-fog">{formatDate(build.time)}</span>
                            </div>
                            <a
                                href={build.download.url}
                                data-astro-prefetch="false"
                                class="font-display rounded-md bg-steel px-4 py-2 text-sm font-medium text-ink transition-colors hover:bg-steel-bright"
                            >
                                {build.download.name}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        ) : (
            <FillBuildList builds={builds} commitBaseUrl={GITHUB_COMMIT} />
        )
    }
</Layout>
