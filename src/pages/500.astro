---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Something broke - Scissors">
    <section class="flex min-h-[70vh] flex-col items-start justify-center py-24">
        <h1
            class="font-display text-7xl font-bold tracking-tight text-steel-bright line-through decoration-steel/60 decoration-dashed decoration-4 sm:text-8xl"
        >
            500
        </h1>
        <p class="font-display mt-6 text-2xl font-medium">That wasn't a clean cut.</p>
        <p class="mt-3 text-fog">
            Something broke on our end. Give it a minute and try again. If it keeps happening, the
            build servers are probably acting emo.
        </p>
        <div class="mt-10">
            <a
                href="/"
                class="font-display rounded-md bg-steel px-6 py-3 font-medium text-ink transition-colors hover:bg-steel-bright"
            >
                Back home
            </a>
        </div>
    </section>
</Layout>
