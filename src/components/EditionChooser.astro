---
interface Props {
    active: 'paper' | 'folia' | 'asp';
}

const { active } = Astro.props;

const editions = [
    { id: 'paper', name: 'Scissors', href: '/downloads' },
    { id: 'folia', name: 'Scissors Folia', href: '/downloads/folia' },
    { id: 'asp', name: 'Scissors ASP', href: '/downloads/asp' },
] as const;
---

<nav class="flex gap-6 border-b border-edge" aria-label="Scissors edition">
    {
        editions.map((edition) => {
            const selected = edition.id === active;
            return (
                <a
                    href={edition.href}
                    aria-current={selected ? 'page' : undefined}
                    class:list={[
                        'font-display -mb-px border-b-2 pb-3 text-sm font-medium transition-colors',
                        selected
                            ? 'border-steel text-paper'
                            : 'border-transparent text-fog hover:border-fog/40 hover:text-paper',
                    ]}
                >
                    {edition.name}
                </a>
            );
        })
    }
</nav>
